{
  // Run & Debug (Ctrl+Shift+D) → pick a configuration → F5
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MPOPI: run site (full stack debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "MPOPI: run site (server only)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "MPOPI: open admin panel",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s/admin",
        "action": "openExternally"
      }
    },
    {
      "name": "MPOPI: production preview",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build && npm start",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
