{
  // Terminal → Run Task…
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MPOPI: first-time setup",
      "type": "shell",
      "command": "npm install && npm run setup",
      "problemMatcher": []
    },
    {
      "label": "MPOPI: start dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^x^" },
        "background": { "activesBegin": ".*Starting.*", "beginsPattern": ".*Starting.*", "endsPattern": ".*Ready in.*" }
      }
    },
    {
      "label": "MPOPI: type check",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "MPOPI: production build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "MPOPI: reset shop data (deletes orders & edits)",
      "type": "npm",
      "script": "reset-data",
      "problemMatcher": []
    }
  ]
}
